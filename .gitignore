.DS_Store
__pycache__/
*.py[cod]
tmp/
output/

# Local source archive. The repository retains source URLs, hashes, and
# page-addressable Markdown derivatives instead of duplicating the PDFs.
vault/Attachments/PDFs/fundar/
vault/Attachments/PDFs/institutional/
vault/Attachments/PDFs/public-domain/
app/public/pdfs/

# Source grayscale LiDAR cache and interrupted downloads. The colorized tile
# pyramid is versioned so clean deployments include the default basemap.
app/public/lidar/dem-2014/
app/public/lidar/**/*.part

# Per-user Obsidian window state
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json

# Next.js and local browser output
app/node_modules/
app/.next/
app/out/
app/*.log
app/*.tsbuildinfo
app/.playwright-cli/
app/output/

# Local deployment state
app/.vercel/

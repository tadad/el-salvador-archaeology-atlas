filters:
  and:
    - 'type == "people"'
    - 'file.inFolder("Peoples")'
properties:
  name:
    displayName: People
  aliases:
    displayName: Aliases
  review_status:
    displayName: Review status
views:
  - type: table
    name: Peoples
    order:
      - name
      - aliases
      - review_status
